{
  "name": "ravel-workshop",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/prerender.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "contracts": "cd .. && python -m scripts.generate_contracts",
    "audit:performance": "node scripts/lighthouse.mjs",
    "typecheck:film": "tsc --project motion/tsconfig.json --noEmit",
    "render:film": "npm run typecheck:film && node scripts/render-film.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "highlight.js": "^11.12.0",
    "lucide-react": "0.487.0",
    "motion": "^14.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.4",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@remotion/bundler": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.9",
    "remotion": "4.0.532",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
