{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "esModuleInterop": true,
    "paths": {
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react": [
        "./node_modules/@types/react/index.d.ts"
      ]
    }
  },
  "include": [
    "src/main.tsx",
    "src/ravel"
  ]
}
