# Preferred local settings. Source exploration and the prepared demo work without an API key.
ANTHROPIC_API_KEY=
UNRAVEL_MODEL=claude-sonnet-4-6
# Leave unset to use ~/.unravel.
UNRAVEL_HOME=
# Vite uses this absolute base URL for og:image and twitter:image.
# Set this to the deployed Vercel domain in Vercel project environment variables.
VITE_SITE_URL=https://your-unravel-domain.vercel.app
# Compatibility: if UNRAVEL_MODEL or UNRAVEL_HOME is unset, the old RAVEL_MODEL
# and RAVEL_HOME variables are still read as fallbacks for existing local configs.

